# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ELEVENLABS_API_KEY: Server-side ElevenLabs API key for STT, TTS, and Conversational AI.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v1

# ADMIN_PASSCODE: Optional administrator passcode. If unset, inline first-run admin setup is shown.
ADMIN_PASSCODE=

# TWILIO SMS / WHATSAPP (Optional real caregiver notification delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# META WHATSAPP BUSINESS CLOUD API (Optional alternative WhatsApp delivery)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
